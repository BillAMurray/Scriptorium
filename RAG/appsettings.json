{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Rag": {
    "OllamaBaseUrl": "http://localhost:11434",
    "ChatModel": "gemma4:12b",
    "EmbeddingModel": "snowflake-arctic-embed:33m",

    "EmbedDocumentPrefix": "",
    "EmbedQueryPrefix": "Represent this sentence for searching relevant passages: ",

    "MaxChunkChars": 2500,
    "ChunkOverlapChars": 400,
    "EmbeddingBatchSize": 32,

    "TopK": 5,
    "MinScore": 0.15,

    "NumCtx": 16384,
    "Temperature": 0.2,
    "Think": false,

    "EnableOcr": true,
    "OcrProvider": "Ollama",
    "OcrModel": "frob/unlimited-ocr:q8_0",
    "OcrMinCharsPerPage": 100,
    "OcrDpi": 300,
    "OcrMaxParallelism": 4,
    "OcrLanguage": "en-US",

    "LaunchBrowser": true,
    "ShutdownWhenBrowserCloses": true,
    "BrowserGraceSeconds": 5,

    "SearchRecursively": true,
    "MaxFileSizeMb": 200,
    "DataSetsRoot": "..\\DataSets",
    "DatabaseFile": "rag-index.db",
    "MaxCachedVectors": 2500000
  }
}
